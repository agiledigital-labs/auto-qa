# Copy this file to .env and fill in real values. .env is gitignored — never commit secrets.

# Jira Cloud auth (used by scripts/jira-fetch.mjs)
# Generate an API token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# Per-project test credentials referenced from context/<PROJECT_KEY>.md.
# Add one var per credential the team's QA context files point at, e.g.:
# PROJ_STAGING_QA_PASSWORD=
